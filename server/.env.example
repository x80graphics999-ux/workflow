DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
UPLOAD_DIR="uploads"
# Optional: set these to also send notifications by email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FixFlow <no-reply@fixflow.local>"

# Hosting only: the first admin account, created when the database is empty.
# Without these, setup creates the demo accounts (password Password@123) instead.
# ADMIN_EMAIL="you@yourcompany.com"
# ADMIN_PASSWORD="a-long-password"
# ADMIN_NAME="Your Name"
